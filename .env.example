# Desarrollo local Supabase CLI:
# 1. Ejecutar: pnpm run supabase:start
# 2. Copiar la Publishable key local desde: pnpm run supabase:status
# 3. Crear/actualizar .env.local con estos valores.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad temporal con clientes anteriores; preferir PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL publica absoluta de la app para redirects de Auth. En local puede quedarse asi.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# OAuth Google local opcional. Tambien debe habilitarse [auth.external.google]
# en supabase/config.toml o en el dashboard remoto de Supabase.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
